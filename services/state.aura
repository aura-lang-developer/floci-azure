export fn getState(): Any => {
  storeInstance
};

export fn incrementRequestsCount(): Unit => {
  storeInstance.totalRequestsCount = storeInstance.totalRequestsCount + 1;
};

export fn clearRequestAuditLog(): Unit => {
  storeInstance.requestAuditLog = [];
};

export fn resetState(): Unit => {
  storeInstance.blobContainers = [];
  storeInstance.blobItems = [];
  storeInstance.queueItems = [];
  storeInstance.serviceBusQueues = [];
  storeInstance.serviceBusTopics = [];
  storeInstance.cosmosDatabases = [];
  storeInstance.tables = [];
  storeInstance.keyVaultSecrets = [];
  storeInstance.keyVaultKeys = [];
  storeInstance.functions = [];
  storeInstance.monitorLogs = [];
  storeInstance.requestAuditLog = [];
  storeInstance.liveLogs = [];
};
