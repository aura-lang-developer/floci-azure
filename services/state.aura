  serviceBusTopics: List<Any>,
  cosmosDatabases: List<Any>,
  tables: List<Any>,
  keyVaultSecrets: List<Any>,
  keyVaultKeys: List<Any>,
  functions: List<Any>,
  monitorLogs: List<Any>,
  liveLogs: List<Any>,
  requestAuditLog: List<Any>,
  totalRequestsCount: Int,
  bootTimestamp: Int,
  nextIdCounter: Int
};

