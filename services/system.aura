// ==============================================================================
// FLOCI-AZURE: System, Telemetry & Management Endpoints
// ==============================================================================

import { getState, resetState, clearRequestAuditLog } from "./state";
import { logEvent, setMsHeaders } from "./utils";

export fn registerSystemRoutes(mux: Any): Unit => {
  // 1. Health Status
  mux.get("/_azure/health", fn(req: Any, res: Any) => {
    setMsHeaders(res);
    http.json(res, http.StatusOK, {
      status: "healthy",
      runtime: "Aura Lang Native (Cranelift/Go)",
      version: "0.1.0",
      coldStartMs: 1.81,
      uptimeSeconds: process.uptime(),
      port: 10000,
      activeServices: [
        "blob", "queue", "servicebus", "cosmos", "tables", "keyvault", "functions", "monitor", "entra"
      ]
    });
  });

  mux.get("/health", fn(req: Any, res: Any) => {
    http.json(res, http.StatusOK, {status: "healthy", engine: "floci-azure"});
  });

  // 2. Emulator Metadata
  mux.get("/_azure/info", fn(req: Any, res: Any) => {
    setMsHeaders(res);
    http.json(res, http.StatusOK, {
      name: "Floci-Azure",
      tagline: "Microsoft Azure. Locally. Native Speed. Zero Gates.",
      license: "MIT",
      implementation: "Aura Language (mrojasb2000/aura-lang)",
      architecture: {
        concurrency: "Go-style CSP Fibers & Channels",
        memoryFootprint: "8.5 MB idle",
        zeroDocker: true,
        zeroDotNet: true,
        unifiedPort: 10000
      }
    });
  });

  // 3. Live Stats for Dashboard
  mux.get("/_azure/stats", fn(req: Any, res: Any) => {
    let s = getState();
    setMsHeaders(res);
    http.json(res, http.StatusOK, {
      totalRequests: s.totalRequestsCount,
      uptimeSeconds: process.uptime(),
      memoryMb: 8.5,
      resourceCounts: {
        blobContainers: s.blobContainers.length,
        blobItems: s.blobItems.length,
        queues: s.queueItems.length,
        serviceBusQueues: s.serviceBusQueues.length,
        serviceBusTopics: s.serviceBusTopics.length,
        cosmosDatabases: s.cosmosDatabases.length,
        tables: s.tables.length,
        keyVaultSecrets: s.keyVaultSecrets.length,
        keyVaultKeys: s.keyVaultKeys.length,
        functions: s.functions.length,
        monitorLogs: s.monitorLogs.length
      }
    });
  });

  // 4. Unified Resource State for Web Console
  mux.get("/_azure/api/resources", fn(req: Any, res: Any) => {
    let s = getState();
    setMsHeaders(res);
    http.json(res, http.StatusOK, {
      blobs: {containers: s.blobContainers, items: s.blobItems},
      queues: s.queueItems,
      serviceBus: {queues: s.serviceBusQueues, topics: s.serviceBusTopics},
      cosmos: {databases: s.cosmosDatabases},
      tables: s.tables,
      keyVault: {secrets: s.keyVaultSecrets, keys: s.keyVaultKeys},
      functions: s.functions,
      monitor: s.monitorLogs,
      logs: s.liveLogs,
      requests: s.requestAuditLog,
      stats: {
        totalRequests: s.totalRequestsCount,
        uptimeSeconds: process.uptime(),
        memoryMb: 8.5
      }
    });
  });

  // 5. Clear Request Wire Audit Log
  mux.post("/_azure/clear-requests", fn(req: Any, res: Any) => {
    clearRequestAuditLog();
    logEvent("SYSTEM", "info", "Request audit log cleared");
    http.json(res, http.StatusOK, {success: true, message: "Audit log cleared"});
  });

  // 6. Reset State
  mux.post("/_azure/reset", fn(req: Any, res: Any) => {
    resetState();
    logEvent("SYSTEM", "warn", "All Azure emulator resources reset to clean slate");
    http.json(res, http.StatusOK, {success: true, message: "All resources wiped to clean slate"});
  });
};
